{
  "name": "@arl/dapp",
  "version": "0.1.0",
  "private": true,
  "description": "ARL web app: wallet, vesting and staking (local Anvil chain only)",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "chain": "bash scripts/local-chain.sh",
    "contracts": "bash scripts/deploy-fixture.sh",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test \"test/unit/**/*.test.ts\"",
    "test:e2e": "NEXT_PUBLIC_ARL_RPC_URL=http://127.0.0.1:18650 next build && playwright test",
    "test:hosted": "rm -rf .hosted-stage && bash ../../scripts/build-site.sh .hosted-stage && playwright test -c playwright.hosted.config.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@arl/zk": "file:../../packages/zk",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/source-code-pro": "5.3.0",
    "@heroicons/react": "2.2.0",
    "@rainbow-me/rainbowkit": "2.2.11",
    "@tanstack/react-query": "5.104.0",
    "@x402/core": "2.27.0",
    "@x402/evm": "2.27.0",
    "blo": "2.0.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hot-toast": "2.6.1",
    "usehooks-ts": "3.1.1",
    "viem": "2.56.9",
    "wagmi": "2.19.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@openzeppelin/merkle-tree": "1.0.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "abitype": "1.2.4",
    "daisyui": "5.7.46",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "type-fest": "5.6.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "ws": "8.22.0",
    "uuid": "11.1.1",
    "decode-uri-component": "0.5.0"
  }
}
