{
  "name": "Hire an Agent with ARL Escrow",
  "nodes": [
    {
      "parameters": {},
      "id": "b1c2d3e4-0001-4000-8000-000000000001",
      "name": "When clicking 'Execute workflow'",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "operation": "create",
        "escrow": "ARL",
        "provider": "0x1111111111111111111111111111111111111111",
        "evaluator": "",
        "hours": 24,
        "description": "Summarise 10 research documents and return a markdown report URL"
      },
      "id": "b1c2d3e4-0002-4000-8000-000000000002",
      "name": "Create Job",
      "type": "n8n-nodes-arl.arl",
      "typeVersion": 1,
      "position": [420, 300],
      "credentials": {
        "arlWalletApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "ARL Client Wallet"
        }
      }
    },
    {
      "parameters": {
        "operation": "setBudget",
        "escrow": "ARL",
        "jobId": "={{ $json.jobId }}",
        "amount": "10"
      },
      "id": "b1c2d3e4-0003-4000-8000-000000000003",
      "name": "Set Budget",
      "type": "n8n-nodes-arl.arl",
      "typeVersion": 1,
      "position": [640, 300],
      "credentials": {
        "arlWalletApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "ARL Client Wallet"
        }
      }
    },
    {
      "parameters": {
        "operation": "fund",
        "escrow": "ARL",
        "jobId": "={{ $json.jobId }}"
      },
      "id": "b1c2d3e4-0004-4000-8000-000000000004",
      "name": "Fund Job",
      "type": "n8n-nodes-arl.arl",
      "typeVersion": 1,
      "position": [860, 300],
      "credentials": {
        "arlWalletApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "ARL Client Wallet"
        }
      }
    },
    {
      "parameters": {
        "operation": "submit",
        "escrow": "ARL",
        "jobId": "={{ $json.jobId }}",
        "deliverable": "https://example.com/deliverables/summary-report.md"
      },
      "id": "b1c2d3e4-0005-4000-8000-000000000005",
      "name": "Provider Submits Work",
      "type": "n8n-nodes-arl.arl",
      "typeVersion": 1,
      "position": [1080, 300],
      "credentials": {
        "arlWalletApi": {
          "id": "REPLACE_WITH_PROVIDER_CREDENTIAL_ID",
          "name": "ARL Provider Wallet"
        }
      }
    },
    {
      "parameters": {
        "operation": "get",
        "escrow": "ARL",
        "jobId": "={{ $json.jobId }}"
      },
      "id": "b1c2d3e4-0006-4000-8000-000000000006",
      "name": "Read Submitted Job",
      "type": "n8n-nodes-arl.arl",
      "typeVersion": 1,
      "position": [1300, 300],
      "credentials": {
        "arlWalletApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "ARL Client Wallet"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "operation": "equal",
              "value2": "Submitted"
            }
          ]
        }
      },
      "id": "b1c2d3e4-0007-4000-8000-000000000007",
      "name": "Deliverable Accepted?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1520, 300]
    },
    {
      "parameters": {
        "operation": "complete",
        "escrow": "ARL",
        "jobId": "={{ $json.jobId }}",
        "reason": "deliverable verified"
      },
      "id": "b1c2d3e4-0008-4000-8000-000000000008",
      "name": "Complete Job",
      "type": "n8n-nodes-arl.arl",
      "typeVersion": 1,
      "position": [1760, 200],
      "credentials": {
        "arlWalletApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "ARL Client Wallet"
        }
      }
    },
    {
      "parameters": {
        "operation": "reject",
        "escrow": "ARL",
        "jobId": "={{ $json.jobId }}",
        "reason": "deliverable incomplete"
      },
      "id": "b1c2d3e4-0009-4000-8000-000000000009",
      "name": "Reject Job",
      "type": "n8n-nodes-arl.arl",
      "typeVersion": 1,
      "position": [1760, 400],
      "credentials": {
        "arlWalletApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "ARL Client Wallet"
        }
      }
    }
  ],
